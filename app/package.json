{
  "name": "android-motion-photo",
  "version": "0.1.4",
  "description": "Offline Windows Motion Photo Studio — internal development build",
  "author": "Motion Photo Studio",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build:preview-engine": "node scripts/build-preview-engine.ts",
    "check:preview-engine": "node scripts/check-preview-engine.ts",
    "build": "npm run check:engine && npm run check:preview-engine && electron-vite build",
    "check:engine": "node scripts/check-engine.ts",
    "test:desktop": "playwright test",
    "pack:win": "npm run build:preview-engine && npm run build && node scripts/package-internal.ts --dir",
    "dist:win:internal": "npm run build:preview-engine && npm run build && node scripts/package-internal.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test tests/unit/*.test.ts",
    "test:integration": "node --test --test-concurrency=2 --test-timeout=120000 tests/integration/*.test.ts",
    "analyze:samples": "node scripts/analyze-samples.ts",
    "fixtures:compat": "node scripts/make-compat-fixtures.ts",
    "validate:motion": "node scripts/validate-motion.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "saxes": "6.0.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
